<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Outer size: the visible loupe plus the shadow gutter below, so 120x48 of actual glass.
       Android's Magnifier is 100x48dp at 1.25x; iOS' loupe is a little wider. -->
  <x:Double x:Key="TextSelectionMagnifierWidth">144</x:Double>
  <x:Double x:Key="TextSelectionMagnifierHeight">72</x:Double>
  <!-- Transparent gutter inside the control for the drop shadow to fall into. A shadow drawn
       outside the control's bounds gets clipped away by the layer that hosts the loupe, so the
       control measures loupe + gutter and the frame is inset by this much. -->
  <Thickness x:Key="TextSelectionMagnifierShadowGutter">12</Thickness>
  <!-- Android's magnifier is a stadium - fully rounded ends - so half the loupe's height. -->
  <CornerRadius x:Key="TextSelectionMagnifierCornerRadius">24</CornerRadius>

  <ControlTheme x:Key="{x:Type TextSelectionMagnifier}"
                TargetType="TextSelectionMagnifier">
    <Setter Property="Width" Value="{DynamicResource TextSelectionMagnifierWidth}" />
    <Setter Property="Height" Value="{DynamicResource TextSelectionMagnifierHeight}" />
    <Setter Property="Zoom" Value="1.25" />
    <Setter Property="VerticalOffset" Value="12" />
    <!-- The loupe follows a drag it must never intercept. -->
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- Opaque backing. The magnified image can be partly transparent - a text field with
               no background of its own leaves the loupe see-through and unreadable - so the frame
               paints a solid surface underneath it. Same brush the focused TextBox uses. -->
          <Border Name="PART_Frame"
                  Margin="{DynamicResource TextSelectionMagnifierShadowGutter}"
                  CornerRadius="{DynamicResource TextSelectionMagnifierCornerRadius}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BoxShadow="0 4 16 0 #66000000, 0 1 3 0 #33000000">
            <!-- PART_Viewport's Background is set in code to the VisualBrush over the TextBox. A
                 Border fills its corner radius with Background, so the image is rounded for free. -->
            <Border Name="PART_Viewport"
                    CornerRadius="{DynamicResource TextSelectionMagnifierCornerRadius}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
