<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="TextSelectHandleSize">24</x:Double>
  <DrawingImage x:Key="TextSelectionHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="{DynamicResource TextSelectionHandlePath}"
                       Brush="{DynamicResource HighlightBrush}"
                       >
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{DynamicResource ThemeForegroundBrush}" LineJoin="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="TextCaretHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="{DynamicResource TextCaretHandlePath}"
                       Brush="{DynamicResource HighlightBrush}"
                       >
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{DynamicResource ThemeForegroundBrush}" LineJoin="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <GeometryGroup x:Key="TextSelectionHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16"/>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,16"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>

  <GeometryGroup x:Key="TextCaretHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16">
          <RectangleGeometry.Transform>
            <TransformGroup >
              <RotateTransform CenterX="16"
                               Angle="-45"/>
            </TransformGroup>
          </RectangleGeometry.Transform>
        </RectangleGeometry>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,22.7"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>

  <ControlTheme x:Key="{x:Type TextSelectionHandle}"
                TargetType="TextSelectionHandle">
    <Setter Property="Background"
            Value="{DynamicResource HighlightBrush}" />
    <Setter Property="HorizontalAlignment"
            Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <!-- The grabbable area is the control's own bounds - Avalonia hit-tests a templated
                 control by its bounds, so anything that overflows them is not reachable. Pad the
                 transparent border so the control itself measures ~48x48 (Android's minimum) and
                 push PART_Indicator back onto the artwork's edge with a matching margin, so
                 GetIndicatorOffset() still lands the teardrop tip exactly on the caret. The
                 vertical growth is bottom-only: TextSelectionCanvas pins the control's TOP to the
                 caret, so the artwork has to stay flush with the top. -->
            <Border Padding="12,0,12,24" IsHitTestVisible="True" Background="Transparent">
              <Image Stretch="Uniform"
                     Cursor="Arrow"
                     Name="PART_HandlePathIcon"
                     Height="{DynamicResource TextSelectHandleSize}"
                     Source="{DynamicResource TextSelectionHandleDrawing}"/>
            </Border>
            <Border Background="Transparent"
                    Name="PART_Indicator"
                    HorizontalAlignment="Center"
                    Width="1"
                    VerticalAlignment="Top"
                    Height="5"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:caret /template/ Image#PART_HandlePathIcon">
      <Setter Property="Source" Value="{DynamicResource TextCaretHandleDrawing}" />
    </Style>
    <Style Selector="^:start /template/ Image#PART_HandlePathIcon">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="-1" ScaleY="1"/>
      </Setter>
    </Style>
    <Style Selector="^:caret /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:end /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
