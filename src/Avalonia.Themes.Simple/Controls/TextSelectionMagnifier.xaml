<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Android's Magnifier is 100x48dp at 1.25x; iOS' loupe is a little wider and rounder. These
       split the difference so one look serves both. -->
  <x:Double x:Key="TextSelectionMagnifierWidth">120</x:Double>
  <x:Double x:Key="TextSelectionMagnifierHeight">48</x:Double>

  <ControlTheme x:Key="{x:Type TextSelectionMagnifier}"
                TargetType="TextSelectionMagnifier">
    <Setter Property="Width" Value="{DynamicResource TextSelectionMagnifierWidth}" />
    <Setter Property="Height" Value="{DynamicResource TextSelectionMagnifierHeight}" />
    <Setter Property="Zoom" Value="1.25" />
    <Setter Property="VerticalOffset" Value="12" />
    <!-- The loupe follows a drag it must never intercept. -->
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- Opaque backing. The magnified image can be partly transparent - a text field with
               no background of its own leaves the loupe see-through and unreadable - so the frame
               paints a solid surface underneath it. Same brush the focused TextBox uses. -->
          <Border CornerRadius="8"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BoxShadow="0 4 16 0 #66000000, 0 1 3 0 #33000000">
            <!-- PART_Viewport's Background is set in code to the VisualBrush over the TextBox. A
                 Border fills its corner radius with Background, so the image is rounded for free. -->
            <Border Name="PART_Viewport" CornerRadius="7" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
